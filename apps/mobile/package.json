{
  "name": "@tradedesk/mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:notifications": "node --test test/firebase-notifications.test.cjs",
    "test:ios": "node --test test/ios-build.test.cjs",
    "check:ios": "node scripts/check-ios-build.cjs",
    "eas-build-pre-install": "node scripts/check-ios-build.cjs --pre-install",
    "build:ios": "npx --yes eas-cli@27.10.0 build --platform ios --profile production",
    "build:ios:preview": "npx --yes eas-cli@27.10.0 build --platform ios --profile preview",
    "build:ios:simulator": "npx --yes eas-cli@27.10.0 build --platform ios --profile ios-simulator",
    "submit:ios": "npx --yes eas-cli@27.10.0 submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "56.0.21",
    "@react-native-firebase/app": "26.0.0",
    "@react-native-firebase/auth": "26.0.0",
    "@react-native-firebase/messaging": "26.0.0",
    "expo": "56.0.24",
    "expo-asset": "56.0.25",
    "expo-audio": "56.0.13",
    "expo-build-properties": "~56.0.27",
    "expo-constants": "56.0.27",
    "expo-crypto": "56.0.5",
    "expo-device": "56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "56.0.7",
    "expo-haptics": "56.0.3",
    "expo-image-manipulator": "56.0.26",
    "expo-image-picker": "56.0.25",
    "expo-linking": "56.0.19",
    "expo-local-authentication": "56.0.5",
    "expo-notifications": "~56.0.26",
    "expo-router": "56.2.22",
    "expo-secure-store": "56.0.4",
    "expo-sharing": "~56.0.27",
    "expo-splash-screen": "56.0.16",
    "expo-status-bar": "56.0.4",
    "expo-system-ui": "56.0.5",
    "graphql": "16.14.2",
    "graphql-ws": "6.4.1",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.8.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
