# Your machine's LAN IP when testing on a phone (not localhost). Use https:// in production.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Download Firebase app config into apps/mobile/google-services.json and/or GoogleService-Info.plist.
# For EAS file environment variables, point these at the uploaded files:
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
