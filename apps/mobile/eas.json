{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "image": "sdk-56",
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tradewithkuber.onrender.com",
        "IOS_PUSH_ENVIRONMENT": "production"
      }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "ios": {
        "image": "sdk-56",
        "buildConfiguration": "Release",
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tradewithkuber.com",
        "IOS_PUSH_ENVIRONMENT": "production"
      },
      "autoIncrement": true
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "preview-32-bit": {
      "extends": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
